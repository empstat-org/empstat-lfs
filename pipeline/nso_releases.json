    "periodicity": "'M' | 'Q' | 'A' — cadence used to enumerate the pending periods",
    "source": "URL to the NSO release / release calendar (shown as a link)",
    "checked": "YYYY-MM-DD you last verified nso_latest",
    "note": "optional free text (e.g. survey name)"
  },
